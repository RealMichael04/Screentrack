# Neon Auth — copy this file to .env.local and fill in the values.
# Auth URL: Neon Console → your project → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# Any random string of 32+ characters (generate with: openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=

# OpenAI: platform.openai.com → API keys (server-side only)
OPENAI_API_KEY=
# TMDB: themoviedb.org → Settings → API → "API Key"
TMDB_API_KEY=
# Neon: project dashboard → Connect → pooled postgresql:// string
DATABASE_URL=
# Optional: use a different OpenAI model
# OPENAI_MODEL=

# Stripe: dashboard → Developers → API keys (server-side only)
STRIPE_SECRET_KEY=
# Stripe: Product catalog → your product → price ID (starts with price_)
STRIPE_PRICE_ID=
# Stripe: webhook signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
